---
import type { BlogPost } from '../lib/posts';
import PostMeta from './PostMeta.astro';
import { estimateReadingTime, getCoverLayout, getPostSlug, getPostUrl } from '../lib/posts';
import { getEnTitleMap, getEnUrl } from '../lib/en';

interface Props {
	posts: BlogPost[];
	compact?: boolean;
	hideCategory?: boolean;
	empty?: string;
}

const { posts, compact = false, hideCategory = false, empty = '这里还没有文章。' } = Astro.props;
// 有英文版的文章，标题下面多一行英文标题，点进去就是英文页。
const enTitles = await getEnTitleMap();
---

<div class:list={['post-list', compact && 'post-list--compact']}>
	{posts.length === 0 && <p class="post-list__empty">{empty}</p>}
	{posts.map((post) => (
		<article class:list={['post-entry', !post.data.cover && 'post-entry--no-cover']} data-category={post.data.category} data-cover-layout={getCoverLayout(post)}>
			<div class="post-entry__content">
				<PostMeta post={post} readingTime={estimateReadingTime(post.body)} hideCategory={hideCategory} />
				<h2><a href={getPostUrl(post)}>{post.data.title}</a></h2>
				{enTitles.has(getPostSlug(post)) && (
					<a class="post-entry__en" href={getEnUrl(getPostSlug(post))} hreflang="en" lang="en">
						<span class="post-entry__en-badge">EN</span>
						{enTitles.get(getPostSlug(post))}
					</a>
				)}
				{post.data.description && <p>{post.data.description}</p>}
			</div>
			{!compact && post.data.cover && (
				<a class="post-entry__cover" href={getPostUrl(post)} aria-label={`阅读 ${post.data.title}`}>
					<img
						src={post.data.cover}
						alt={post.data.coverAlt ?? ''}
						loading="lazy"
						width="1600"
						height="1000"
						style={`object-position: ${post.data.coverPosition ?? '50% 50%'}`}
					/>
				</a>
			)}
		</article>
	))}
</div>
