---
import type { MarkdownHeading } from 'astro';
import type { BlogPost } from '../lib/posts';
import BaseLayout from './BaseLayout.astro';
import PostMeta from '../components/PostMeta.astro';
import ReadingProgress from '../components/ReadingProgress.astro';
import ImageLightbox from '../components/ImageLightbox.astro';
import { categoryMap, getCoverLayout, getPostUrl, getWritingSeason, slugifyTag } from '../lib/posts';

interface Props {
	post: BlogPost;
	headings: MarkdownHeading[];
	readingTime: string;
	prev?: BlogPost;
	next?: BlogPost;
	related: BlogPost[];
}

const { post, headings, readingTime, prev, next, related } = Astro.props;
const toc = headings.filter((heading) => heading.depth > 1 && heading.depth < 4);
const writtenAt = `写于 ${getWritingSeason(post.data.publishDate)}${post.data.location ? ` · ${post.data.location}` : ''}`;
const cleanHeadingText = (text: string) => text.replace(/#$/, '').trim();
const category = categoryMap[post.data.category];
const showToc = toc.length >= 2;
---

<BaseLayout
	title={post.data.title}
	description={post.data.description}
	image={post.data.cover}
	type="article"
	publishedTime={post.data.publishDate}
	updatedTime={post.data.updatedDate}
	tags={post.data.tags}
>
	<ReadingProgress />
	<article class="article-shell" data-category={post.data.category} data-cover-layout={getCoverLayout(post)}>
		<header class="article-header">
			<a class="article-category-link" href={category.href}>{category.label}</a>
			<h1>{post.data.title}</h1>
			<PostMeta post={post} readingTime={readingTime} variant="article" hideCategory />
			{post.data.description && <p class="article-description">{post.data.description}</p>}
			{post.data.cover && (
				<figure class="article-cover-frame">
					<img
						class="article-cover"
						src={post.data.cover}
						alt={post.data.coverAlt ?? ''}
						loading="eager"
						width="1600"
						height="1000"
						style={`object-position: ${post.data.coverPosition ?? '50% 50%'}`}
					/>
					{post.data.coverAlt && <figcaption class="image-caption">{post.data.coverAlt}</figcaption>}
				</figure>
			)}
		</header>

		{showToc && (
			<details class="toc" open>
				<summary>目录</summary>
				<ol>
					{toc.map((heading) => (
						<li class={`toc-depth-${heading.depth}`}>
							<a href={`#${heading.slug}`}>{cleanHeadingText(heading.text)}</a>
						</li>
					))}
				</ol>
			</details>
		)}

		<div class="prose">
			<slot />
		</div>

		<footer class="article-ending">
			<p>{writtenAt}</p>
			{post.data.tags.length > 0 && (
				<div class="article-ending__tags" aria-label="文章标签">
					{post.data.tags.map((tag) => <a href={`/tags/${slugifyTag(tag)}/`}>#{tag}</a>)}
				</div>
			)}
		</footer>

		<nav class="post-neighbors" aria-label="上一篇和下一篇">
			{prev ? (
				<a href={getPostUrl(prev)} rel="prev"><small>上一篇</small><span>{prev.data.title}</span></a>
			) : <span />}
			{next ? (
				<a href={getPostUrl(next)} rel="next"><small>下一篇</small><span>{next.data.title}</span></a>
			) : <span />}
		</nav>

		{related.length > 0 && (
			<section class="related-section" aria-labelledby="related-title">
				<h2 id="related-title">相关文章</h2>
				<ul>
					{related.map((item) => <li><a href={getPostUrl(item)}>{item.data.title}</a></li>)}
				</ul>
			</section>
		)}
	</article>
	<ImageLightbox />
</BaseLayout>
