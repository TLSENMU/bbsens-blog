---
import BaseLayout from '../../layouts/BaseLayout.astro';
import { getAllTags, getPublicPosts, slugifyTag } from '../../lib/posts';

const posts = await getPublicPosts();
const tags = getAllTags(posts);
const maxCount = Math.max(1, ...tags.map(([, count]) => count));
---

<BaseLayout title="标签" description="按标签浏览文章。">
	<section class="page-shell" aria-labelledby="tags-title">
		<p class="page-kicker">Tags</p>
		<h1 id="tags-title" class="page-title">标签</h1>
		<p class="page-description">{tags.length} 个标签，把散落在不同栏目里的文章重新串起来。</p>
		<div class="tag-cloud">
			{tags.map(([tag, count]) => (
				<a href={`/tags/${slugifyTag(tag)}/`} style={`--tag-weight: ${((count - 1) / Math.max(1, maxCount - 1)).toFixed(2)}`}>{tag} <span>{count}</span></a>
			))}
		</div>
	</section>
</BaseLayout>
