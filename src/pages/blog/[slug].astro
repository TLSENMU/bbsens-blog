---
import { render } from 'astro:content';
import BlogPostLayout from '../../layouts/BlogPostLayout.astro';
import {
	estimateReadingTime,
	getAdjacentPosts,
	getPublishedPosts,
	getPostSlug,
	getPostUrl,
	getPublicPosts,
	getRelatedPosts,
} from '../../lib/posts';
import { getEnTitleMap, getEnUrl } from '../../lib/en';

export async function getStaticPaths() {
	const posts = await getPublishedPosts();
	return posts.map((post) => ({
		params: { slug: getPostSlug(post) },
		props: { post },
	}));
}

const { post } = Astro.props;
const posts = await getPublicPosts();
const { Content, headings } = await render(post);
const { prev, next } = post.data.unlisted ? { prev: undefined, next: undefined } : getAdjacentPosts(posts, post);
const related = post.data.unlisted ? [] : getRelatedPosts(posts, post);
const readingTime = estimateReadingTime(post.body);
const link = (item: typeof post) => ({ url: getPostUrl(item), title: item.data.title });
const enTitles = await getEnTitleMap();
const slug = getPostSlug(post);
const altUrl = enTitles.has(slug) ? getEnUrl(slug) : undefined;
---

<BlogPostLayout
	post={post}
	headings={headings}
	readingTime={readingTime}
	prev={prev && link(prev)}
	next={next && link(next)}
	related={related.map(link)}
	altUrl={altUrl}
>
	<Content />
</BlogPostLayout>
