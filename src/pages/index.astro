---
import { getCollection } from 'astro:content';
import BaseLayout from '../layouts/BaseLayout.astro';
import PostMeta from '../components/PostMeta.astro';
import { siteConfig } from '../config';
import { categoryMap, estimateReadingTime, getPostUrl, getPublicPosts } from '../lib/posts';
import { getSeasonUrl, sortSeasons } from '../lib/seasons';

const posts = await getPublicPosts();
const seasons = sortSeasons(await getCollection('seasons', ({ data }) => !data.draft));
const latestSeason = seasons[0];

const seasonalPickCategories: Array<keyof typeof categoryMap> = ['journey', 'food', 'people'];
const seasonalPicks = seasonalPickCategories
	.map((category) => posts.find((post) => post.data.category === category && post.data.featured))
	.filter(Boolean);

const recentPosts = posts
	.slice()
	.sort((a, b) => {
		const aDate = (a.data.updatedDate ?? a.data.publishDate).getTime();
		const bDate = (b.data.updatedDate ?? b.data.publishDate).getTime();
		return bDate - aDate;
	})
	.slice(0, 5);

// 「这一季」的三段小注直接从季笺正文的 ## 小节里取，不再在首页里写死。
function extractSeasonNotes(body = '') {
	const notes: Array<{ label: string; text: string }> = [];
	const sections = body.split(/^##\s+/m).slice(1);
	for (const section of sections) {
		const [heading, ...rest] = section.split('\n');
		const text = rest
			.map((line) => line.trim())
			.filter((line) => line && !line.startsWith('>') && !line.startsWith('#'))
			.join(' ')
			.replace(/[*_`]/g, '');
		if (heading?.trim() && text) notes.push({ label: heading.trim(), text: text.length > 72 ? `${text.slice(0, 72)}…` : text });
	}
	return notes.slice(0, 3);
}
const seasonNotes = latestSeason ? extractSeasonNotes(latestSeason.body) : [];

const entranceCategories: Array<keyof typeof categoryMap> = ['journey', 'food', 'people'];
const entrances = entranceCategories.map((key) => ({
	key,
	...categoryMap[key],
	count: posts.filter((post) => post.data.category === key).length,
}));

// 「拾影」优先用真实文章封面；不够四张时用占位图补齐。
const placeholderImages = [
	{ src: '/assets/covers/travel.jpg', alt: '占位图：路途上的柔和色块', caption: '路上的光', href: '/journey/' },
	{ src: '/assets/covers/daily.jpg', alt: '占位图：餐桌和房间气氛', caption: '一顿慢饭', href: '/food/' },
	{ src: '/assets/covers/essay.jpg', alt: '占位图：傍晚城市与笔记', caption: '见面以后', href: '/people/' },
	{ src: '/assets/covers/notes.jpg', alt: '占位图：房间与纸页气氛', caption: '房间一角', href: '/thoughts/' },
];
const coverImages = posts
	.filter((post) => post.data.cover && post.data.cover.startsWith('/assets/posts/'))
	.slice(0, 4)
	.map((post) => ({ src: post.data.cover!, alt: post.data.coverAlt ?? post.data.title, caption: post.data.title, href: getPostUrl(post), position: post.data.coverPosition }));
const quietImages = [...coverImages, ...placeholderImages].slice(0, 4);
---

<BaseLayout>
	<section class="home-hero-full" aria-label="首页封面">
		<img src="/assets/covers/home-hero-fuji.webp" alt="冬季本栖湖对岸的富士山、湖面与星轨" loading="eager" width="1600" height="900" />
	</section>

	<section class="home-preview-shell" aria-labelledby="home-title">
		<header class="home-hero-statement">
			<p class="page-kicker">Road / Table / People</p>
			<h1 id="home-title">{siteConfig.siteDescription}</h1>
		</header>

		<nav class="home-entrances entrance-grid" aria-label="栏目入口">
			{entrances.map((item) => (
				<a href={item.href} data-category={item.key}>
					<span>{item.label}</span>
					<small>{item.description}</small>
					<em>{item.count > 0 ? `${item.count} 篇` : item.note}</em>
				</a>
			))}
		</nav>

		{latestSeason && (
			<section class="season-feature" aria-labelledby="season-feature-title">
				<div class="season-feature__text">
					<p class="page-kicker">这一季</p>
					<h2 id="season-feature-title">{latestSeason.data.year} {latestSeason.data.season}</h2>
					<p>{latestSeason.data.description}</p>
					{seasonNotes.length > 0 && (
						<dl>
							{seasonNotes.map((item) => (
								<div>
									<dt>{item.label}</dt>
									<dd>{item.text}</dd>
								</div>
							))}
						</dl>
					)}
					<a class="season-link" href={getSeasonUrl(latestSeason)}>读完整季笺 →</a>
				</div>
				{latestSeason.data.cover && (
					<a class="season-feature__cover" href={getSeasonUrl(latestSeason)} aria-label="读完整季笺">
						<img src={latestSeason.data.cover} alt={latestSeason.data.coverAlt ?? ''} loading="lazy" width="1600" height="1000" />
					</a>
				)}
			</section>
		)}

		{seasonalPicks.length > 0 && (
		<details class="curated-section curated-section--folded" open>
			<summary aria-controls="curated-list">
				<div class="section-heading">
					<p class="page-kicker">Selected This Season</p>
					<h2 id="curated-title">当季精选</h2>
				</div>
				<span aria-hidden="true">展开</span>
			</summary>
			<div id="curated-list" class="curated-list" aria-labelledby="curated-title">
				{seasonalPicks.map((post) => (
					<article data-category={post.data.category}>
						<PostMeta post={post} readingTime={estimateReadingTime(post.body)} />
						<h3><a href={getPostUrl(post)}>{post.data.title}</a></h3>
						{post.data.description && <p>{post.data.description}</p>}
					</article>
				))}
			</div>
		</details>
		)}

		<section class="recent-section" aria-labelledby="recent-title">
			<div class="section-heading">
				<p class="page-kicker">Recently Updated</p>
				<h2 id="recent-title">最近更新</h2>
			</div>
			<div class="recent-list">
				{recentPosts.map((post) => (
					<article data-category={post.data.category}>
						<PostMeta post={post} readingTime={estimateReadingTime(post.body)} />
						<h3><a href={getPostUrl(post)}>{post.data.title}</a></h3>
						{post.data.description && <p>{post.data.description}</p>}
						{post.data.cover && (
							<a class="recent-list__thumb" href={getPostUrl(post)} aria-hidden="true" tabindex="-1">
								<img src={post.data.cover} alt="" loading="lazy" width="400" height="400" style={`object-position: ${post.data.coverPosition ?? '50% 50%'}`} />
							</a>
						)}
					</article>
				))}
			</div>
		</section>

		<section class="quiet-images" aria-labelledby="quiet-images-title">
			<div class="section-heading">
				<p class="page-kicker">Selected Images</p>
				<h2 id="quiet-images-title">拾影</h2>
			</div>
			<div class="quiet-image-strip">
				{quietImages.map((image) => (
					<figure>
						<a href={image.href}>
							<img src={image.src} alt={image.alt} loading="lazy" width="1600" height="1000" style={image.position ? `object-position: ${image.position}` : undefined} />
						</a>
						<figcaption>{image.caption}</figcaption>
					</figure>
				))}
			</div>
		</section>
	</section>
</BaseLayout>
