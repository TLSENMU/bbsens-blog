---
import { getEntry, render } from 'astro:content';
import BaseLayout from '../../layouts/BaseLayout.astro';
import { formatDate } from '../../lib/posts';

// 正文在 src/content/about/about.md，写作台左栏的「关于」就是改它。
const entry = await getEntry('about', 'about');
if (!entry) throw new Error('缺少 src/content/about/about.md');
const { Content } = await render(entry);
---

<BaseLayout title={entry.data.title} description={entry.data.description}>
	<section class="article-shell" aria-labelledby="about-title">
		<p class="page-kicker">{entry.data.kicker}</p>
		<h1 id="about-title" class="page-title">{entry.data.title}</h1>
		<div class="prose">
			<Content />
		</div>
		{entry.data.updatedDate && (
			<p class="about-updated">最后更新于 {formatDate(entry.data.updatedDate)}</p>
		)}
	</section>
</BaseLayout>
